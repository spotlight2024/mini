FROM selenium/node-chrome:138.0.7204.157-chromedriver-138.0.7204.157-grid-4.34.0-20250717

# 设置工作目录
WORKDIR /opt/scripts

# 切换到root用户进行安装和配置
USER root

ENV SE_EXTRA_LIBS=/opt/selenium/extensions/adb-session-factory-1.1-SNAPSHOT.jar

# 安装必要的工具
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    ca-certificates \
    vim \
    adb \
    android-tools-adb \
    && rm -rf /var/lib/apt/lists/*

# 创建脚本目录
RUN mkdir -p /opt/scripts /opt/custom-scripts /opt/adb

# 创建 ADB 配置目录
RUN mkdir -p /root/.android

# 复制自定义脚本到镜像
COPY ./scripts/custom_startup.sh /opt/custom-scripts/
COPY ./scripts/adb_init.sh /opt/custom-scripts/
RUN chmod +x /opt/custom-scripts/custom_startup.sh /opt/custom-scripts/adb_init.sh

COPY ./node/adb-session-factory/target/adb-session-factory-1.1-SNAPSHOT.jar /opt/selenium/extensions/

# 复制 selenium-server.jar 到容器
COPY ./node/selenuim/selenium_server_deploy.jar /opt/selenium/selenium-server.jar
RUN chmod +x /opt/selenium/selenium-server.jar

# 复制自定义 entrypoint 脚本
COPY ./entrypoint.custom-selenium-chrome.sh /opt/bin/custom-entrypoint.sh
RUN chmod +x /opt/bin/custom-entrypoint.sh

# 切换回selenium用户
USER 1200

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:4444/status || exit 1

# 使用自定义启动脚本
ENTRYPOINT ["/opt/bin/custom-entrypoint.sh"] 