FROM selenium/node-chrome:128.0.6613.137-chromedriver-128.0.6613.137-grid-4.34.0-20250717

# 设置工作目录
WORKDIR /opt/scripts

# 切换到root用户进行安装和配置
USER root

ENV SE_EXTRA_LIBS=/opt/selenium/extensions/adb-session-factory-1.1-SNAPSHOT.jar
ENV ADB_PROXY_LOG_LEVEL=INFO

# 安装必要的工具
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    ca-certificates \
    vim \
    adb \
    android-tools-adb \
    python3 \
    python3-pip \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# 创建脚本目录
RUN mkdir -p /opt/scripts /opt/custom-scripts /opt/adb /opt/scripts/logs

# 创建 ADB 配置目录
RUN mkdir -p /root/.android

# 设置日志目录权限
RUN chmod 755 /opt/scripts/logs
RUN chown -R 1200:1200 /opt/scripts/logs

# 复制自定义脚本到镜像
COPY ./scripts/custom_startup.sh /opt/custom-scripts/
COPY ./scripts/adb_init.sh /opt/custom-scripts/
COPY ./scripts/proxy/adb_proxy.py /opt/custom-scripts/
COPY ./scripts/stop_adb_proxy.sh /opt/custom-scripts/
COPY ./scripts/setup_proxy_config.sh /opt/custom-scripts/
COPY ./test.sh /opt/custom-scripts/
RUN chmod +x /opt/custom-scripts/custom_startup.sh
RUN chmod +x /opt/custom-scripts/adb_proxy.py
RUN chmod +x /opt/custom-scripts/stop_adb_proxy.sh
RUN chmod +x /opt/custom-scripts/setup_proxy_config.sh
RUN chmod +x /opt/custom-scripts/test.sh

# 创建Chrome扩展目录（动态生成）
RUN mkdir -p /opt/chrome_extensions/proxy_auth
RUN chown -R 1200:1200 /opt/chrome_extensions/proxy_auth

# 创建Chrome包装脚本
RUN echo '#!/bin/bash' > /usr/local/bin/chrome-with-proxy && \
    echo '# Chrome启动包装脚本，强制加载代理扩展' >> /usr/local/bin/chrome-with-proxy && \
    echo '' >> /usr/local/bin/chrome-with-proxy && \
    echo 'EXTENSION_PATH="/opt/chrome_extensions/proxy_auth"' >> /usr/local/bin/chrome-with-proxy && \
    echo 'ORIGINAL_CHROME="/usr/bin/google-chrome.original"' >> /usr/local/bin/chrome-with-proxy && \
    echo '' >> /usr/local/bin/chrome-with-proxy && \
    echo '# 检查是否需要加载扩展' >> /usr/local/bin/chrome-with-proxy && \
    echo 'if [ "$PROXY_ENABLED" = "true" ] && [ -d "$EXTENSION_PATH" ]; then' >> /usr/local/bin/chrome-with-proxy && \
    echo '    # 检查是否已经包含扩展参数' >> /usr/local/bin/chrome-with-proxy && \
    echo '    if [[ "$*" != *"--load-extension"* ]]; then' >> /usr/local/bin/chrome-with-proxy && \
    echo '        echo "添加代理扩展到Chrome启动参数: $EXTENSION_PATH" >&2' >> /usr/local/bin/chrome-with-proxy && \
    echo '        exec "$ORIGINAL_CHROME" --load-extension="$EXTENSION_PATH" --disable-blink-features=AutomationControlled "$@"' >> /usr/local/bin/chrome-with-proxy && \
    echo '    else' >> /usr/local/bin/chrome-with-proxy && \
    echo '        echo "扩展参数已存在，直接启动Chrome: $*" >&2' >> /usr/local/bin/chrome-with-proxy && \
    echo '        exec "$ORIGINAL_CHROME" "$@"' >> /usr/local/bin/chrome-with-proxy && \
    echo '    fi' >> /usr/local/bin/chrome-with-proxy && \
    echo 'else' >> /usr/local/bin/chrome-with-proxy && \
    echo '    echo "代理未启用或扩展不存在，直接启动Chrome: $*" >&2' >> /usr/local/bin/chrome-with-proxy && \
    echo '    exec "$ORIGINAL_CHROME" "$@"' >> /usr/local/bin/chrome-with-proxy && \
    echo 'fi' >> /usr/local/bin/chrome-with-proxy

RUN chmod +x /usr/local/bin/chrome-with-proxy

# 备份原始Chrome并替换为包装脚本
RUN mv /usr/bin/google-chrome /usr/bin/google-chrome.original
RUN ln -s /usr/local/bin/chrome-with-proxy /usr/bin/google-chrome

# 复制 selenium-server.jar 到容器
COPY ./node/selenuim/selenium_server_deploy.jar /opt/selenium/selenium-server.jar
RUN chmod +x /opt/selenium/selenium-server.jar

# 复制自定义 entrypoint 脚本
COPY ./entrypoint.custom-selenium-chrome.sh /opt/bin/custom-entrypoint.sh
RUN chmod +x /opt/bin/custom-entrypoint.sh

# 切换回selenium用户
USER 1200

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:4444/status || exit 1

# 使用自定义启动脚本
ENTRYPOINT ["/opt/bin/custom-entrypoint.sh"] 