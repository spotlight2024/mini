# tinyproxy配置 - 透明代理转发到上游认证代理
# Chrome通过HTTP_PROXY环境变量透明使用，无需任何Chrome配置

# 基本配置
User nobody
Group nogroup
Port 8888
Listen 127.0.0.1
Timeout 600
DefaultErrorFile "/usr/share/tinyproxy/default.html"
StatFile "/usr/share/tinyproxy/stats.html"
Logfile "/var/log/tinyproxy/tinyproxy.log"
LogLevel Info
PidFile "/var/run/tinyproxy/tinyproxy.pid"

# 访问控制 - 只允许本地连接
Allow 127.0.0.1
Allow 172.16.0.0/12

# 性能优化
MaxClients 100
MinSpareServers 5
MaxSpareServers 20
StartServers 10
MaxRequestsPerChild 0

# 上游代理配置 - 将被脚本替换
# UPSTREAM_PROXY_PLACEHOLDER

# 禁用转发某些头部信息（提高匿名性）
DisableViaHeader Yes

# 过滤规则（可选）
# FilterCaseSensitive Off
# FilterDefaultDeny Yes