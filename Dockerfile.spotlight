FROM python:3.12-slim

# 设置pip镜像源
RUN pip config set global.index-url https://pypi.tuna.tsinghua.edu.cn/simple

# 安装系统依赖（包含构建工具以编译诸如 netifaces 等包）
RUN apt-get update && apt-get install -y \
    wget \
    gnupg \
    unzip \
    curl \
    android-tools-adb \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# 基础环境
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 设置工作目录
WORKDIR /app

# 复制依赖文件
COPY requirements.txt .

# 安装Python依赖
RUN pip install --no-cache-dir -r requirements.txt

# 复制应用代码
COPY hybrid_driver/ ./hybrid_driver/
COPY config/ ./config/
COPY scripts/ ./scripts/

# 创建日志目录
RUN mkdir -p logs

# 暴露端口（默认 10001，可用 API_PORT 覆盖）
EXPOSE 10001

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:${API_PORT:-10001}/health || exit 1

# 启动命令（统一入口，尊重环境变量）
CMD ["sh", "-c", "uvicorn hybrid_driver.server_optimized:app --host ${API_HOST:-0.0.0.0} --port ${API_PORT:-10001} --log-level ${LOG_LEVEL:-info}"]