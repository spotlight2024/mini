# Chrome Driver版本配置
# 留空使用默认版本，或指定具体版本如 "114.0.5735.90"
CHROME_DRIVER_VERSION=

# 自定义Chrome Driver下载URL（可选）
# 如果指定了CHROME_DRIVER_VERSION但想使用自定义下载地址
CHROME_DRIVER_DOWNLOAD_URL=

# 是否安装证书
# true: 安装证书，false: 不安装证书
SE_INSTALL_CERTIFICATES=false

# Selenium Grid配置
SELENIUM_HUB_HOST=selenium-hub
SELENIUM_HUB_PUBLISH_PORT=4442
SELENIUM_HUB_SUBSCRIBE_PORT=4443

# 节点配置
SELENIUM_NODE_COUNT=2
SELENIUM_NODE_MAX_SESSIONS=4
SELENIUM_NODE_SESSION_TIMEOUT=300

# 网络配置
NETWORK_NAME=spotlight-network 