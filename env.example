# SpotLight API 环境配置模板
# 复制此文件为 .env 并根据需要修改

# ===== API 配置 =====
# API 主机地址
API_HOST=0.0.0.0

# API 端口号
API_PORT=10001

# 日志级别 (debug, info, warning, error)
LOG_LEVEL=info

# 运行环境 (development, production)
ENVIRONMENT=development

# ===== Docker 配置 =====
# 镜像名称
IMAGE_NAME=spotlight-api

# 镜像标签
IMAGE_TAG=latest

# Docker 镜像仓库地址 (可选)
# DOCKER_REGISTRY=your_registry.com

# 构建参数
BUILD_DATE=
GIT_COMMIT=

# ===== 开发环境配置 =====
# Python 环境设置
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# ===== 网络配置 =====
# 网络名称
NETWORK_NAME=spotlight-network

# ===== 存储配置 =====
# 日志目录
LOG_DIR=./logs

# 配置目录
CONFIG_DIR=./config

# 证书目录
CERTS_DIR=./certs 