FROM selenium/node-chrome:4.33.0-20250606

# 设置环境变量
ENV SE_EVENT_BUS_HOST=selenium-hub
ENV SE_EVENT_BUS_PUBLISH_PORT=4442
ENV SE_EVENT_BUS_SUBSCRIBE_PORT=4443
ENV SE_NODE_MAX_SESSIONS=4
ENV SE_NODE_OVERRIDE_MAX_SESSIONS=true
ENV SE_NODE_SESSION_TIMEOUT=300
ENV SE_NODE_REGISTER_CYCLE=10000
ENV SE_NODE_REGISTER_PERIOD=10000
ENV SE_NODE_PORT=5555

# Chrome Driver版本配置
ENV CHROME_DRIVER_VERSION=""
ENV CHROME_DRIVER_DOWNLOAD_URL=""

# 切换到root用户进行安装
USER root

# 安装必要的工具
RUN apt-get update && apt-get install -y \
    wget \
    curl \
    unzip \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 创建Chrome Driver管理脚本
RUN echo '#!/bin/bash' > /opt/bin/chrome-driver-manager.sh && \
    echo 'set -e' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'CHROME_DRIVER_VERSION=${CHROME_DRIVER_VERSION:-""}' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'CHROME_DRIVER_DOWNLOAD_URL=${CHROME_DRIVER_DOWNLOAD_URL:-""}' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'echo "Chrome Driver版本管理脚本启动..."' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'if [ ! -z "$CHROME_DRIVER_VERSION" ]; then' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    echo "下载Chrome Driver版本: $CHROME_DRIVER_VERSION"' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    if [ ! -z "$CHROME_DRIVER_DOWNLOAD_URL" ]; then' >> /opt/bin/chrome-driver-manager.sh && \
    echo '        DOWNLOAD_URL="$CHROME_DRIVER_DOWNLOAD_URL"' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    else' >> /opt/bin/chrome-driver-manager.sh && \
    echo '        DOWNLOAD_URL="https://chromedriver.storage.googleapis.com/$CHROME_DRIVER_VERSION/chromedriver_linux64.zip"' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    fi' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    cd /tmp' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    wget -O chromedriver.zip "$DOWNLOAD_URL"' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    unzip chromedriver.zip' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    chmod +x chromedriver' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    mv chromedriver /usr/local/bin/' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    rm chromedriver.zip' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    echo "Chrome Driver $CHROME_DRIVER_VERSION 安装完成"' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'fi' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'if [ "$SE_INSTALL_CERTIFICATES" = "true" ]; then' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    echo "安装证书..."' >> /opt/bin/chrome-driver-manager.sh && \
    echo '    /opt/bin/install-certificates.sh' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'fi' >> /opt/bin/chrome-driver-manager.sh && \
    echo 'echo "Chrome Driver管理完成"' >> /opt/bin/chrome-driver-manager.sh

# 创建证书安装脚本
RUN echo '#!/bin/bash' > /opt/bin/install-certificates.sh && \
    echo 'set -e' >> /opt/bin/install-certificates.sh && \
    echo 'echo "开始安装证书..."' >> /opt/bin/install-certificates.sh && \
    echo 'mkdir -p /usr/local/share/ca-certificates' >> /opt/bin/install-certificates.sh && \
    echo 'update-ca-certificates' >> /opt/bin/install-certificates.sh && \
    echo 'echo "证书安装完成"' >> /opt/bin/install-certificates.sh

# 设置脚本权限
RUN chmod +x /opt/bin/chrome-driver-manager.sh /opt/bin/install-certificates.sh

# 创建证书目录
RUN mkdir -p /opt/certs

# 切换回selenium用户
USER 1200

# 暴露端口
EXPOSE 5555

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:5555/status || exit 1

# 启动脚本
RUN echo '#!/bin/bash' > /opt/bin/entrypoint.sh && \
    echo '/opt/bin/chrome-driver-manager.sh' >> /opt/bin/entrypoint.sh && \
    echo 'exec /opt/bin/entry_point.sh "$@"' >> /opt/bin/entrypoint.sh && \
    chmod +x /opt/bin/entrypoint.sh

ENTRYPOINT ["/opt/bin/entrypoint.sh"] 