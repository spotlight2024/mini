# SpotLight Hybrid Driver API 环境配置

# API 服务配置
API_HOST=0.0.0.0
API_PORT=10001
API_RELOAD=false
API_WORKERS=1

# 日志配置
LOG_LEVEL=INFO
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_FILE=true

# WebDriver 配置
WEBDRIVER_MODE=local
SELENIUM_TIMEOUT=30

# 设备池配置
MAX_DEVICES=10
DEVICE_TIMEOUT=60
DEVICE_CONNECTION_RETRY=3

# 操作配置
DEFAULT_TIMEOUT=10
ELEMENT_WAIT_TIMEOUT=10
PAGE_LOAD_TIMEOUT=30

# 网络配置
NETWORK_TIMEOUT=30

# 监控配置
METRICS_ENABLED=true
AUTO_SCALE_ENABLED=false
